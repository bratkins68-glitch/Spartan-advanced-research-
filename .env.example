# Example environment variables for Spartan Advanced Research

# When TEST_MODE=true the payment endpoints return a simulated invoice and no real
# payment provider calls are made. Set to false in production.
TEST_MODE=true

# NOWPayments (only required when TEST_MODE=false)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here

# Resend (for sending emails)
RESEND_API_KEY=your_resend_api_key_here

# Admin order notification email (where order emails are sent)
ORDER_TO_EMAIL=spartanadvancedresearch@gmail.com
ORDER_FROM_EMAIL="Spartan Orders <onboarding@resend.dev>"

# Optional: if customers provide an email in the checkout request, the site will
# send them a simple invoice. The customer email should be sent in the request
# under the key `customer_email` or `email`.
